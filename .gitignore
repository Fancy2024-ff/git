# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Node.js
node_modules/
core/generator/dist/
apps/web/dist/

# Environment
.env
core/agents/.env
*.local.env
.env.local

# Platform auth (real keys, never commit)
data/platform-auth/*.json
!data/platform-auth/*.json.example

# Data (generated at runtime)
data/apps/
data/prds/
data/projects/
data/reports/
data/outputs/
data/pipeline_state.json
# Stray runtime artifacts (must only live under data/outputs/{jobId}/)
/pipeline-report.json
/qa-report.json
/*.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
.wrangler/
.claude/plans/
# Local Claude settings (may contain secrets)
.claude/settings.local.json
