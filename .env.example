# Mini-program Factory 环境配置
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交真实 key）

# ── 运行环境 ────────────────────────────────────────────────
# development: 鉴权可选、热重载开启、绑定 127.0.0.1
# production:  必须设置 DASHBOARD_API_KEY，否则服务拒绝启动
APP_ENV=development

# ── 后端服务 (FastAPI) ──────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# Dashboard 与后端通信的 API Key。生产环境必填。
# 留空时仅在 development 下放行所有请求。
# ⚠️ Docker 部署注意：此值会在构建时 bake 进前端 JS bundle，更换后需重新 build dashboard image
DASHBOARD_API_KEY=
# 允许跨域的前端 origin（CORS）
DASHBOARD_ORIGIN=http://localhost:5173
# Pipeline 子进程超时（秒）
PIPELINE_TIMEOUT_SECONDS=600

# ── LLM 配置（可选，缺失时跳过 LLM 增强，不阻断生成）────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.3

# ── 数据源 API (可选, 没有则用本地规则) ─────────────────────────
QIMAI_API_KEY=
SENSORTOWER_API_KEY=

# ── Generator 服务地址 ──────────────────────────────────────
GENERATOR_URL=http://localhost:3100
# Generator 服务 API Key（与后端共享，留空则不鉴权）
GENERATOR_API_KEY=
# Generator 生成项目输出目录（可选）
# GENERATOR_OUTPUT_DIR=

# ── QA 构建超时（秒，可选）──────────────────────────────────
QA_INSTALL_TIMEOUT=180
QA_BUILD_TIMEOUT=180

# ── 小程序平台凭证（上架用，可选）──────────────────────────────
WECHAT_APPID=
WECHAT_SECRET=
ALIPAY_APPID=
DOUYIN_APPID=
