# Mini-program Factory 环境配置

# LLM 配置
ANTHROPIC_API_KEY=sk-ant-xxxx
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.3

# 数据源 API (可选, 没有则用 LLM 推荐)
QIMAI_API_KEY=
SENSORTOWER_API_KEY=

# Generator 服务地址
GENERATOR_URL=http://localhost:3100

# 微信小程序
WECHAT_APPID=
WECHAT_SECRET=

# 支付宝小程序
ALIPAY_APPID=

# 抖音小程序
DOUYIN_APPID=
