# -- Miniapp Factory: FastAPI Backend --
FROM python:3.11-slim

WORKDIR /app

# System deps + Node.js 22 (needed for pipeline QA: npm install + npm run build)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g wrangler && \
    rm -rf /var/lib/apt/lists/*

# Application code (new structure: config/settings + shared live under core/agents)
COPY apps/ apps/
COPY core/ core/
COPY data/inputs/ data/inputs/
COPY data/platforms/ data/platforms/

# Install Python dependencies (pyproject is in core/agents)
RUN pip install --no-cache-dir core/agents/

# Ensure runtime directories exist
RUN mkdir -p data/outputs data/inputs/real data/platform-auth

ENV APP_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=8000
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/pipeline/status || exit 1

# New entrypoint: apps/api/main.py
CMD ["python", "apps/api/main.py"]
